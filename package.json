{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-websearch-deepseek",
  "version": "0.1.0",
  "description": "DeepSeek-powered web search provider for OpenCode's built-in websearch tool.",
  "type": "module",
  "license": "MIT",
  "author": "OniVe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OniVe/opencode-websearch-deepseek.git"
  },
  "homepage": "https://github.com/OniVe/opencode-websearch-deepseek#readme",
  "bugs": {
    "url": "https://github.com/OniVe/opencode-websearch-deepseek/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "websearch",
    "deepseek",
    "search"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "prepare": "node -e \"const fs=require('node:fs');if(fs.existsSync('dist/index.js'))process.exit(0);try{require.resolve('typescript')}catch{process.exit(0)};require('node:child_process').execSync('npm run build',{stdio:'inherit'})\"",
    "prepack": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.0.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.8.2"
  }
}
